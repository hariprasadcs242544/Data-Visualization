      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([votes])) - LOOKUP(ZN(SUM([votes])), -1)) / ABS(LOOKUP(ZN(SUM([votes])), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_0651491505963012]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Top &quot; + STR([Parameters].[Parameter 0651491504914435]) + &quot; Restaurants by Total&#13;&#10;Votes&quot;' />
      </column>
      <column caption='Cumulative Votes(RUNNING_SUM).' datatype='integer' name='[Calculation_1263367556341761]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' Restaurant Rank' datatype='integer' name='[Calculation_1263367558295555]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([votes]), &apos;desc&apos;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption=' City Window Avg Cost. ' datatype='real' name='[Calculation_1263367559983108]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(AVG([approx_cost(for two people)]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Difference from Window Sum. ' datatype='real' name='[Calculation_1263367561433093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([votes]) - WINDOW_AVG(SUM([votes]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
